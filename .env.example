# AI Study Assistant - Environment Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# API Configuration
# ============================================
# Get your Groq API key from: https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here

# Model selection (default: llama-3.1-8b-instant)
# Available models: llama-3.1-8b-instant, llama-3.1-70b-versatile, mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-8b-instant

# ============================================
# Application Configuration
# ============================================
# Application environment (development, staging, production)
APP_ENV=development

# Enable debug mode (true/false)
DEBUG=false

# Session timeout in minutes
SESSION_TIMEOUT=30

# Maximum topic length
MAX_TOPIC_LENGTH=1000

# ============================================
# Rate Limiting
# ============================================
# Maximum requests per minute
RATE_LIMIT_PER_MINUTE=10

# Maximum requests per hour
RATE_LIMIT_PER_HOUR=100

# ============================================
# Cache Configuration
# ============================================
# Enable caching (true/false)
ENABLE_CACHE=true

# Cache TTL in seconds
CACHE_TTL=3600

# ============================================
# Feature Flags
# ============================================
# Enable dark mode toggle
ENABLE_DARK_MODE=true

# Enable export functionality
ENABLE_EXPORT=true

# Enable bookmarks
ENABLE_BOOKMARKS=true

# Enable analytics
ENABLE_ANALYTICS=true

# ============================================
# Security
# ============================================
# Secret key for session management (generate a random string)
SECRET_KEY=your_secret_key_here_change_in_production

# Enable HTTPS redirect (true/false)
FORCE_HTTPS=false